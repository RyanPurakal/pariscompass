# Copy to .env and fill in. .env is gitignored.
# Load into your shell with: set -a; source .env; set +a

# dev (default), test or prod
SPRING_PROFILES_ACTIVE=dev

# Required in prod, optional in dev (projections return 503 without it)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Comma-separated frontend origins. Required in prod; dev defaults to http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Postgres. Required in prod; dev defaults match docker-compose.yml (host port 5433)
DATABASE_URL=jdbc:postgresql://localhost:5433/pariscompass
DATABASE_USERNAME=pariscompass
DATABASE_PASSWORD=pariscompass

# ETL: re-ingest even when a source file is unchanged
APP_ETL_FORCE=false

# HTTP port (most hosts inject PORT)
PORT=8081
