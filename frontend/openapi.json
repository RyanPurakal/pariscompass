{
  "components": {
    "schemas": {
      "AlignmentResponse": {
        "properties": {
          "band": {
            "enum": [
              "HIGH",
              "MEDIUM",
              "LOW"
            ],
            "nullable": true,
            "type": "string"
          },
          "components": {
            "items": {
              "$ref": "#/components/schemas/Component"
            },
            "type": "array"
          },
          "disclaimer": {
            "type": "string"
          },
          "formulaVersion": {
            "type": "string"
          },
          "iso3": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "reason": {
            "nullable": true,
            "type": "string"
          },
          "score": {
            "format": "double",
            "nullable": true,
            "type": "number"
          }
        },
        "required": [
          "band",
          "components",
          "disclaimer",
          "formulaVersion",
          "iso3",
          "name",
          "reason",
          "score"
        ],
        "type": "object"
      },
      "ComparisonResponse": {
        "properties": {
          "countries": {
            "items": {
              "$ref": "#/components/schemas/CountrySeries"
            },
            "type": "array"
          },
          "from": {
            "format": "int32",
            "nullable": true,
            "type": "integer"
          },
          "metric": {
            "type": "string"
          },
          "to": {
            "format": "int32",
            "nullable": true,
            "type": "integer"
          },
          "unit": {
            "type": "string"
          }
        },
        "required": [
          "countries",
          "from",
          "metric",
          "to",
          "unit"
        ],
        "type": "object"
      },
      "Component": {
        "properties": {
          "available": {
            "type": "boolean"
          },
          "effectiveWeight": {
            "format": "double",
            "nullable": true,
            "type": "number"
          },
          "fromYear": {
            "format": "int32",
            "nullable": true,
            "type": "integer"
          },
          "key": {
            "type": "string"
          },
          "metric": {
            "type": "string"
          },
          "note": {
            "nullable": true,
            "type": "string"
          },
          "points": {
            "format": "int32",
            "type": "integer"
          },
          "subScore": {
            "format": "double",
            "nullable": true,
            "type": "number"
          },
          "toYear": {
            "format": "int32",
            "nullable": true,
            "type": "integer"
          },
          "unit": {
            "type": "string"
          },
          "value": {
            "format": "double",
            "nullable": true,
            "type": "number"
          },
          "weight": {
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "available",
          "effectiveWeight",
          "fromYear",
          "key",
          "metric",
          "note",
          "points",
          "subScore",
          "toYear",
          "unit",
          "value",
          "weight"
        ],
        "type": "object"
      },
      "CountryInfo": {
        "properties": {
          "iso3": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "iso3",
          "name"
        ],
        "type": "object"
      },
      "CountryMetrics": {
        "properties": {
          "co2PerCapita": {
            "format": "double",
            "nullable": true,
            "type": "number"
          },
          "co2TotalMt": {
            "format": "double",
            "nullable": true,
            "type": "number"
          },
          "iso3": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "renewablesSharePct": {
            "format": "double",
            "nullable": true,
            "type": "number"
          },
          "source": {
            "$ref": "#/components/schemas/SourceInfo"
          },
          "temperatureAnomalyC": {
            "format": "double",
            "nullable": true,
            "type": "number"
          },
          "years": {
            "additionalProperties": {
              "format": "int32",
              "type": "integer"
            },
            "type": "object"
          }
        },
        "required": [
          "co2PerCapita",
          "co2TotalMt",
          "iso3",
          "name",
          "renewablesSharePct",
          "source",
          "temperatureAnomalyC",
          "years"
        ],
        "type": "object"
      },
      "CountryProjectionResponse": {
        "properties": {
          "metrics": {
            "$ref": "#/components/schemas/CountryMetrics"
          },
          "projection": {
            "$ref": "#/components/schemas/ProjectionResponse"
          }
        },
        "required": [
          "metrics",
          "projection"
        ],
        "type": "object"
      },
      "CountrySeries": {
        "properties": {
          "iso3": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "points": {
            "items": {
              "$ref": "#/components/schemas/SeriesPoint"
            },
            "type": "array"
          }
        },
        "required": [
          "iso3",
          "name",
          "points"
        ],
        "type": "object"
      },
      "CountrySeriesResponse": {
        "properties": {
          "from": {
            "format": "int32",
            "nullable": true,
            "type": "integer"
          },
          "iso3": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "series": {
            "items": {
              "$ref": "#/components/schemas/MetricSeries"
            },
            "type": "array"
          },
          "to": {
            "format": "int32",
            "nullable": true,
            "type": "integer"
          }
        },
        "required": [
          "from",
          "iso3",
          "name",
          "series",
          "to"
        ],
        "type": "object"
      },
      "Coverage": {
        "properties": {
          "countries": {
            "format": "int32",
            "type": "integer"
          },
          "defaultYear": {
            "format": "int32",
            "nullable": true,
            "type": "integer"
          },
          "firstYear": {
            "format": "int32",
            "nullable": true,
            "type": "integer"
          },
          "lastYear": {
            "format": "int32",
            "nullable": true,
            "type": "integer"
          },
          "values": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "countries",
          "defaultYear",
          "firstYear",
          "lastYear",
          "values"
        ],
        "type": "object"
      },
      "Entry": {
        "properties": {
          "iso3": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "rank": {
            "format": "int32",
            "type": "integer"
          },
          "value": {
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "iso3",
          "name",
          "rank",
          "value"
        ],
        "type": "object"
      },
      "MetricInfo": {
        "properties": {
          "code": {
            "type": "string"
          },
          "coverage": {
            "$ref": "#/components/schemas/Coverage"
          },
          "description": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "source": {
            "$ref": "#/components/schemas/Source"
          },
          "unit": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "coverage",
          "description",
          "name",
          "source",
          "unit"
        ],
        "type": "object"
      },
      "MetricSeries": {
        "properties": {
          "metric": {
            "type": "string"
          },
          "points": {
            "items": {
              "$ref": "#/components/schemas/SeriesPoint"
            },
            "type": "array"
          },
          "unit": {
            "type": "string"
          }
        },
        "required": [
          "metric",
          "points",
          "unit"
        ],
        "type": "object"
      },
      "Problem": {
        "description": "RFC 9457 problem details. 'code' is stable and machine-readable.",
        "properties": {
          "code": {
            "example": "COUNTRY_NOT_FOUND",
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "status": {
            "format": "int32",
            "type": "integer"
          },
          "timestamp": {
            "format": "date-time",
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "status",
          "title"
        ],
        "type": "object"
      },
      "ProjectionOutput": {
        "properties": {
          "co2Direction": {
            "type": "string"
          },
          "confidence": {
            "type": "string"
          },
          "keyDrivers": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "projectedCo2Mt": {
            "items": {
              "$ref": "#/components/schemas/YearValue"
            },
            "type": "array"
          },
          "risks": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "summary": {
            "type": "string"
          }
        },
        "required": [
          "co2Direction",
          "confidence",
          "keyDrivers",
          "projectedCo2Mt",
          "risks",
          "summary"
        ],
        "type": "object"
      },
      "ProjectionResponse": {
        "properties": {
          "alignmentBand": {
            "enum": [
              "HIGH",
              "MEDIUM",
              "LOW"
            ],
            "nullable": true,
            "type": "string"
          },
          "alignmentScore": {
            "format": "double",
            "nullable": true,
            "type": "number"
          },
          "attempts": {
            "format": "int32",
            "type": "integer"
          },
          "baseYear": {
            "format": "int32",
            "type": "integer"
          },
          "baseYearCo2Mt": {
            "format": "double",
            "type": "number"
          },
          "cached": {
            "type": "boolean"
          },
          "country": {
            "type": "string"
          },
          "fallbackReason": {
            "nullable": true,
            "type": "string"
          },
          "generatedAt": {
            "format": "date-time",
            "type": "string"
          },
          "generatedBy": {
            "type": "string"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "iso3": {
            "type": "string"
          },
          "latencyMs": {
            "format": "int64",
            "type": "integer"
          },
          "model": {
            "nullable": true,
            "type": "string"
          },
          "projection": {
            "$ref": "#/components/schemas/ProjectionOutput"
          },
          "promptVersion": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "validationErrors": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "alignmentBand",
          "alignmentScore",
          "attempts",
          "baseYear",
          "baseYearCo2Mt",
          "cached",
          "country",
          "fallbackReason",
          "generatedAt",
          "generatedBy",
          "id",
          "iso3",
          "latencyMs",
          "model",
          "projection",
          "promptVersion",
          "status",
          "validationErrors"
        ],
        "type": "object"
      },
      "RankingResponse": {
        "properties": {
          "countriesWithData": {
            "format": "int32",
            "type": "integer"
          },
          "entries": {
            "items": {
              "$ref": "#/components/schemas/Entry"
            },
            "type": "array"
          },
          "metric": {
            "type": "string"
          },
          "order": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "year": {
            "format": "int32",
            "type": "integer"
          }
        },
        "required": [
          "countriesWithData",
          "entries",
          "metric",
          "order",
          "unit",
          "year"
        ],
        "type": "object"
      },
      "SeriesPoint": {
        "properties": {
          "value": {
            "format": "double",
            "type": "number"
          },
          "year": {
            "format": "int32",
            "type": "integer"
          }
        },
        "required": [
          "value",
          "year"
        ],
        "type": "object"
      },
      "Source": {
        "properties": {
          "citation": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "homepage": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "citation",
          "code",
          "homepage",
          "name"
        ],
        "type": "object"
      },
      "SourceInfo": {
        "properties": {
          "co2": {
            "type": "string"
          },
          "renewables": {
            "type": "string"
          },
          "temp": {
            "type": "string"
          }
        },
        "required": [
          "co2",
          "renewables",
          "temp"
        ],
        "type": "object"
      },
      "YearValue": {
        "properties": {
          "co2Mt": {
            "format": "double",
            "type": "number"
          },
          "year": {
            "format": "int32",
            "type": "integer"
          }
        },
        "required": [
          "co2Mt",
          "year"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Country-level CO2, electricity and temperature data from Our World in Data and Copernicus ERA5, a deterministic Paris alignment score, and schema-validated five-year CO2 projections.\n\nEvery error is RFC 9457 `application/problem+json` with a stable `code` field.",
    "license": {
      "name": "Data: CC BY 4.0 (Our World in Data)",
      "url": "https://creativecommons.org/licenses/by/4.0/"
    },
    "title": "Paris Compass API",
    "version": "v1"
  },
  "openapi": "3.0.1",
  "paths": {
    "/api/compare": {
      "get": {
        "operationId": "compare",
        "parameters": [
          {
            "description": "2 to 4 comma-separated ISO3 codes",
            "example": "USA,CHN,IND",
            "in": "query",
            "name": "countries",
            "required": true,
            "schema": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          {
            "in": "query",
            "name": "metric",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "from",
            "required": false,
            "schema": {
              "format": "int32",
              "maximum": 2100,
              "minimum": 1750,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "to",
            "required": false,
            "schema": {
              "format": "int32",
              "maximum": 2100,
              "minimum": 1750,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ComparisonResponse"
                }
              }
            },
            "description": "One series per country, in request order"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "UNKNOWN_METRIC, INVALID_COUNTRY_LIST, INVALID_YEAR_RANGE"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "COUNTRY_NOT_FOUND"
          }
        },
        "summary": "One metric for 2 to 4 countries, side by side",
        "tags": [
          "Metrics"
        ]
      }
    },
    "/api/countries": {
      "get": {
        "operationId": "getAllCountries",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CountryInfo"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Countries"
          }
        },
        "summary": "List every country with ingested data, sorted by name",
        "tags": [
          "Countries"
        ]
      }
    },
    "/api/countries/{iso3}": {
      "get": {
        "operationId": "getCountryMetrics",
        "parameters": [
          {
            "in": "path",
            "name": "iso3",
            "required": true,
            "schema": {
              "pattern": "^[A-Za-z]{3}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CountryMetrics"
                }
              }
            },
            "description": "Metrics snapshot"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "iso3 is not three letters"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "COUNTRY_NOT_FOUND"
          }
        },
        "summary": "Latest value of each headline metric, with the year of each value",
        "tags": [
          "Countries"
        ]
      }
    },
    "/api/countries/{iso3}/alignment": {
      "get": {
        "description": "Computed in Java from historical data. score and band are null when the emissions trend cannot be computed; reason explains why.",
        "operationId": "getAlignment",
        "parameters": [
          {
            "in": "path",
            "name": "iso3",
            "required": true,
            "schema": {
              "pattern": "^[A-Za-z]{3}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlignmentResponse"
                }
              }
            },
            "description": "Score with every component's input, sub-score and weight"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "COUNTRY_NOT_FOUND"
          }
        },
        "summary": "Deterministic Paris alignment score (formula v1, see SCORING.md)",
        "tags": [
          "Countries"
        ]
      }
    },
    "/api/countries/{iso3}/projection": {
      "post": {
        "description": "Returns a stored projection when the inputs are unchanged (cached=true). Otherwise asks the model for schema-validated JSON, retries once, and falls back to labeled trend extrapolation.",
        "operationId": "getCountryProjection",
        "parameters": [
          {
            "in": "path",
            "name": "iso3",
            "required": true,
            "schema": {
              "pattern": "^[A-Za-z]{3}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CountryProjectionResponse"
                }
              }
            },
            "description": "Metrics snapshot plus projection"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "COUNTRY_NOT_FOUND"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "INSUFFICIENT_DATA: fewer than 6 of the last 10 years of CO2 data"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "RATE_LIMITED, with a Retry-After header"
          }
        },
        "summary": "Five-year CO2 projection (rate limited)",
        "tags": [
          "Countries"
        ]
      }
    },
    "/api/countries/{iso3}/projections": {
      "get": {
        "operationId": "getProjectionHistory",
        "parameters": [
          {
            "in": "path",
            "name": "iso3",
            "required": true,
            "schema": {
              "pattern": "^[A-Za-z]{3}$",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "format": "int32",
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ProjectionResponse"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Stored projections"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "COUNTRY_NOT_FOUND"
          }
        },
        "summary": "Stored projections for a country, newest first",
        "tags": [
          "Countries"
        ]
      }
    },
    "/api/countries/{iso3}/series": {
      "get": {
        "operationId": "getCountrySeries",
        "parameters": [
          {
            "in": "path",
            "name": "iso3",
            "required": true,
            "schema": {
              "pattern": "^[A-Za-z]{3}$",
              "type": "string"
            }
          },
          {
            "description": "Comma-separated metric codes from GET /api/metrics; default all",
            "in": "query",
            "name": "metrics",
            "required": false,
            "schema": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          {
            "in": "query",
            "name": "from",
            "required": false,
            "schema": {
              "format": "int32",
              "maximum": 2100,
              "minimum": 1750,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "to",
            "required": false,
            "schema": {
              "format": "int32",
              "maximum": 2100,
              "minimum": 1750,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CountrySeriesResponse"
                }
              }
            },
            "description": "One series per requested metric; years without data are absent"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
